# Copy to .env in the directory where you start the harness. It loads automatically.
# Terminal environment variables and explicit CLI flags override file settings.
HARNESS_PROVIDER=bedrock
AWS_REGION=ap-south-1
# Replace with the exact model or inference-profile ID/ARN that works in your Bedrock playground.
HARNESS_BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
HARNESS_SANDBOX=docker
HARNESS_MAX_OUTPUT_TOKENS=4096
HARNESS_MODEL_TIMEOUT_SECONDS=60
HARNESS_MAX_MODEL_CALLS=40

# Add your real key only to .env. BEDROCK_API_KEY is accepted as an alias for
# AWS_BEARER_TOKEN_BEDROCK; the standard SDK variable takes precedence if both exist.
BEDROCK_API_KEY=
# Alternatively use an existing AWS_PROFILE / temporary AWS credentials.
